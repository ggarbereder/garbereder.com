---
import Main from '../layouts/main.astro';
import Footer from '../components/footer.astro';

const containerClass = 'max-w-3xl mx-auto px-4 sm:px-6';
---

<Main
  title="Page not found | Gerrit Garbereder"
  description="The page you are looking for does not exist on garbereder.com."
  noindex
>
  <main id="main-content" class="min-h-screen bg-slate-900 text-slate-300">
    <div class={`${containerClass} py-12`}>
      <h1 class="text-4xl font-light text-slate-100">Page not found</h1>
      <p class="mt-6 text-lg text-slate-300 leading-relaxed">
        Sorry, there is nothing at this address. It may have moved, or the link
        may be mistyped.
      </p>
      <p class="mt-4 leading-relaxed">
        <a
          href="/"
          class="text-cyan-300 underline underline-offset-2 hover:text-orange-400 transition-colors"
          >Back to home</a
        >
      </p>
    </div>
  </main>
  <Footer />
</Main>
