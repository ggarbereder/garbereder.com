---
import Head from '../components/head.astro';
import SkipLink from '../components/skip-link.astro';
import '../styles/index.scss';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /** Optional LCP image preload for the head. */
  lcpPreload?: { srcset: string; sizes: string; type: string };
}

const { title, description, canonical, keywords, noindex, lcpPreload } =
  Astro.props;
---

<!doctype html>
<html class="motion-safe:scroll-smooth nojs" lang="en">
  <Head
    title={title}
    description={description}
    canonical={canonical}
    keywords={keywords}
    noindex={noindex}
    lcpPreload={lcpPreload}
  />
  <body>
    <SkipLink />
    <slot />
  </body>
</html>
