{
  "name": "@garbereder/config",
  "private": true,
  "type": "module",
  "description": "Shared tsconfig, ESLint, Prettier, Playwright and html-validate config for the apps in this repo",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./playwright": {
      "types": "./playwright.d.ts",
      "default": "./playwright.js"
    },
    "./tsconfig.json": "./tsconfig.json",
    "./htmlvalidate.json": "./htmlvalidate.json"
  },
  "peerDependencies": {
    "@playwright/test": "*"
  },
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier-plugin-astro": "^1.1.1",
    "typescript-eslint": "^8.71.2"
  }
}
