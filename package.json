{
  "name": "garbereder",
  "private": true,
  "type": "module",
  "version": "1.2.4",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run typecheck",
    "lint:eslint": "npx eslint",
    "lint:prettier": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run lint && npm run build && npm run test:html --workspaces --if-present && npm run test:e2e --workspaces --if-present",
    "prepare": "husky",
    "security:audit": "node scripts/security-audit.mjs",
    "security:outdated": "npm outdated --workspaces --include-workspace-root",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@emnapi/core": ">=1.11.3 <2",
    "@emnapi/runtime": ">=1.11.3 <2",
    "@emnapi/wasi-threads": ">=1.2.3 <2",
    "@humanfs/node": ">=0.16.8 <0.17",
    "brace-expansion": ">=5.0.9 <6",
    "browserslist": ">=4.28.8 <5",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.9 <4",
    "js-yaml": ">=4.3.2 <5",
    "qs": ">=6.16.0 <7",
    "svgo": ">=4.0.2",
    "undici@7": ">=7.30.1 <8",
    "undici@8": ">=8.12.2 <9",
    "zod": ">=4.6.6 <5"
  },
  "devDependencies": {
    "@garbereder/config": "*",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true,
    "workerd": false
  }
}
