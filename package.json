{
  "name": "garbereder.com",
  "type": "module",
  "version": "1.0.94",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run typecheck",
    "lint:eslint": "npx eslint",
    "lint:prettier": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test": "npm run lint && npm run build && npm run test:html && npm run test:e2e",
    "prepare": "husky",
    "security:audit": "node scripts/security-audit.mjs",
    "security:outdated": "npm outdated",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@emnapi/core": ">=1.11.3 <2",
    "@emnapi/runtime": ">=1.11.3 <2",
    "@emnapi/wasi-threads": ">=1.2.3 <2",
    "@humanfs/node": ">=0.16.8 <0.17",
    "brace-expansion": ">=5.0.9 <6",
    "browserslist": ">=4.28.8 <5",
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.9 <4",
    "js-yaml": ">=4.3.2 <5",
    "qs": ">=6.16.0 <7",
    "svgo": ">=4.0.2",
    "undici@7": ">=7.30.1 <8",
    "undici@8": ">=8.12.2 <9",
    "zod": ">=4.6.6 <5"
  },
  "devDependencies": {
    "@astrojs/preact": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "astro": "^7.3.8",
    "cssnano": "^9.8.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "html-validate": "^11.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "preact": "^11.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-imagetools": "^12.0.1",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "unrs-resolver": true,
    "workerd": false
  }
}
