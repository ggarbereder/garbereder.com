{
  "name": "garbereder.com",
  "type": "module",
  "version": "1.0.76",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run typecheck",
    "lint:eslint": "npx eslint",
    "lint:prettier": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "cy:run": "cypress run --config baseUrl=http://localhost:4321",
    "cy:run:a11y": "cypress run --config baseUrl=http://localhost:4321 --spec 'cypress/e2e/accessibility.cy.js'",
    "cy:run:visual": "cypress run --config baseUrl=http://localhost:4321 --spec 'cypress/e2e/visual/**/*.cy.js'",
    "test:e2e": "start-server-and-test dev http://localhost:4321 cy:run",
    "test:a11y": "start-server-and-test dev http://localhost:4321 cy:run:a11y",
    "test:visual": "start-server-and-test dev http://localhost:4321 cy:run:visual",
    "test:visual:update": "rm -rf cypress-image-diff-screenshots/baseline && start-server-and-test dev http://localhost:4321 cy:run:visual",
    "test:coverage": "CYPRESS_COVERAGE=true start-server-and-test dev http://localhost:4321 cy:run",
    "test": "npm run lint && npm run test:e2e",
    "prepare": "husky",
    "security:audit": "node scripts/security-audit.mjs",
    "security:outdated": "npm outdated",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@emnapi/core": ">=1.11.3 <2",
    "@emnapi/runtime": ">=1.11.3 <2",
    "@emnapi/wasi-threads": ">=1.2.3 <2",
    "@humanfs/node": ">=0.16.8 <0.17",
    "brace-expansion": ">=5.0.9 <6",
    "browserslist": ">=4.28.8 <5",
    "cypress-axe": {
      "cypress": "$cypress"
    },
    "esbuild": ">=0.28.1",
    "fast-uri": ">=3.1.7 <4",
    "js-yaml": ">=4.3.2 <5",
    "qs": ">=6.16.0 <7",
    "svgo": ">=4.0.2"
  },
  "devDependencies": {
    "@astrojs/preact": "^6.0.5",
    "@cypress/code-coverage": "^4.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "astro": "^7.3.1",
    "axe-core": "^4.13.0",
    "cssnano": "^9.0.3",
    "cypress": "^16.0.0",
    "cypress-axe": "^1.7.0",
    "cypress-image-diff-js": "^2.8.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "nyc": "^18.0.0",
    "postcss": "^8.5.28",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.104.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@16.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
