---
import Layout from '../layouts/layout.astro';
---

<Layout
  title="Page not found | Start at :05"
  description="The page you are looking for does not exist on start-at-05.com."
  noindex
>
  <div class="start-at-05 min-h-screen flex flex-col">
    <main id="main-content" class="sa05-hero flex-1 px-4 py-12">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <h1 class="start-at-05-h1 font-light leading-tight tracking-tight">
          Page not found
        </h1>
        <p class="sa05-hero-lead text-lg mt-6 leading-relaxed">
          Sorry, there is nothing at this address. It may have moved, or the
          link may be mistyped.
        </p>
        <p class="mt-4 leading-relaxed">
          <a href="/" class="sa05-accent underline underline-offset-2"
            >Back to Start at :05</a
          >
        </p>
      </div>
    </main>
  </div>
</Layout>
