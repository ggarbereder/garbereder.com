---
import '@fontsource-variable/quicksand';
import quicksandLatin from '@fontsource-variable/quicksand/files/quicksand-latin-wght-normal.woff2?url';

import StructuredData from './structured-data.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  /** Keep the page out of search results (no canonical, robots noindex). */
  noindex?: boolean;
  /** Optional LCP image preload, so the image is discoverable from HTML immediately. Must match the image's srcset and sizes. */
  lcpPreload?: { srcset: string; sizes: string; type: string };
}

const {
  title = 'Gerrit Garbereder | Senior Engineering Manager',
  description = 'Senior Engineering Manager with expertise in leading cross-functional teams, project delivery, and fostering innovation.',
  canonical = 'https://www.garbereder.com/',
  keywords = 'Engineering Manager, Project Management, Team Leadership, Software Development, Innovation',
  noindex = false,
  lcpPreload,
} = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <link
    rel="preload"
    href={quicksandLatin}
    as="font"
    type="font/woff2"
    crossorigin
  />

  {lcpPreload && (
    <link
      rel="preload"
      as="image"
      type={lcpPreload.type}
      imagesrcset={lcpPreload.srcset}
      imagesizes={lcpPreload.sizes}
    />
  )}
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Gerrit Garbereder" />
  <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />

  <meta property="og:title" content={title} />
  <meta property="og:type" content="website" />
  {!noindex && <meta property="og:url" content={canonical} />}
  <meta
    property="og:image"
    content="https://www.garbereder.com/img/portrait.jpg"
  />
  <meta property="og:image:width" content="845" />
  <meta property="og:image:height" content="845" />
  <meta property="og:image:alt" content="Portrait of Gerrit Garbereder" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Gerrit Garbereder" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta
    name="twitter:image"
    content="https://www.garbereder.com/img/portrait.jpg"
  />

  {!noindex && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <StructuredData
    title={title}
    description={description}
    canonical={canonical}
  />

  <script>
    document.querySelector('html')?.classList.remove('nojs');
  </script>
</head>
